+/** Aceita somente um sensor de canais tipo 24 com associação exata de schemas. */
+[[nodiscard]] bool exact_authored_channel_slot(const SlotDefinition& definition) noexcept {
+    return definition.slotType == scriptable_auth::kType24SlotType
+           && definition.authSchema == scriptable_auth::kType24Schema
+           && (definition.flags & format::kSlotSchemaJoinExact) != 0;
+}
+
+/** Substitui todos os canais autorais de saída do sensor tipo 24. */
+[[nodiscard]] int slot_set_authored_channels(lua_State* state) {
+    const auto* const handle =
+        static_cast<const SlotHandle*>(luaL_checkudata(state, 1, kSlotMetatable));
+    SlotDefinition slot{};
+    if (!current_slot(state, *handle, slot)) {
+        return luaL_error(state, "activity slot is stale or invalid");
+    }
+    if (!exact_authored_channel_slot(slot)) {
+        return luaL_error(state, "activity slot is not an exact type-24 channel sensor");
+    }
+    static constexpr std::array<std::string_view, 2> kDeclared{"values", "blend"};
+    refuse_unknown_arguments(state, kDeclared);
+
+    lua_getfield(state, 2, "values");
+    luaL_checktype(state, -1, LUA_TTABLE);
+    const int list = lua_gettop(state);
+    const std::size_t count = lua_rawlen(state, list);
+    if (count == 0 || count > scriptable_auth::kType24ChannelCapacity) {
+        lua_pop(state, 1);
+        return luaL_error(state, "values must contain one to four channel numbers");
+    }
+
+    const lua_Number blendNumber = [&]() -> lua_Number {
+        lua_getfield(state, 2, "blend");
+        const lua_Number result = lua_isnil(state, -1) ? 0.0 : luaL_checknumber(state, -1);
+        lua_pop(state, 1);
+        return result;
+    }();
+    const float blend = static_cast<float>(blendNumber);
+    if (!std::isfinite(blend) || blend < 0.F) {
+        lua_pop(state, 1);
+        return luaL_error(state, "blend must be a finite non-negative number");
+    }
+
+    scriptable_auth::Type24Body body{};
+    body.count = static_cast<std::uint8_t>(count);
+    for (std::size_t index = 0; index < count; ++index) {
+        lua_rawgeti(state, list, static_cast<lua_Integer>(index + 1));
+        if (!lua_isnumber(state, -1)) {
+            lua_pop(state, 2);
+            return luaL_error(state, "values must contain numbers");
+        }
+        const float value = static_cast<float>(lua_tonumber(state, -1));
+        lua_pop(state, 1);
+        if (!std::isfinite(value) || value < scriptable_auth::kType24MinimumValue
+            || value > scriptable_auth::kType24MaximumValue) {
+            lua_pop(state, 1);
+            return luaL_error(state, "channel values must be finite numbers in [-100, 100]");
+        }
+        body.channels[index] = {0, value, blend};
+    }
+    lua_pop(state, 1);
+
+    std::array<std::byte, scriptable_auth::kType24MaximumByteCount> bytes{};
+    std::size_t written = 0;
+    std::size_t bits = 0;
+    if (!scriptable_auth::encode_type24(body, bytes, written, bits)) {
+        return luaL_error(state, "type-24 channel encoder failed");
+    }
+    return queue_slot_auth(state,
+                           slot,
+                           scriptable_auth::kType24Schema,
+                           bits,
+                           std::span(bytes).first(written));
+}
