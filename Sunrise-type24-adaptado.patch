+    body.channels[0] = {-1, 0.F, 0.F};
+    assert(!auth::encode_type24(body, bytes, written, bits));
+    body.channels[0] = {0, 0.F, 0.F};
+    assert(!auth::encode_type24(body, std::span(bytes).first(12), written, bits));
+    assert(auth::encode_type24(body, bytes, written, bits));
+    // Vetor independente: um canal, revisão deslocada para 0x80000000 e dois floats zero.
+    assert(written == 13 && bytes[0] == std::byte{0x30});
+    for (std::size_t i = 1; i < written; ++i) assert(bytes[i] == std::byte{0});
+    bytes[0] = std::byte{0x20}; // Revisão negativa no formato de transmissão.
+    assert(!auth::decode_type24_body(std::span(bytes).first(written), decoded));
+    bytes[0] = std::byte{0xA0}; // Cinco canais excedem a capacidade de quatro.
+    assert(!auth::decode_type24_body(std::span(bytes).first(written), decoded));
+    std::int32_t next = 0;
+    assert(auth::next_type24_revision({}, next) && next == 1);
+    assert(auth::next_type24_revision({42, true}, next) && next == 43);
+    assert(auth::next_type24_revision({INT32_MAX - 1, true}, next) && next == INT32_MAX);
+    assert(!auth::next_type24_revision({INT32_MAX, true}, next) && next == 0);
+    assert(!auth::next_type24_revision({-1, true}, next) && next == 0);
+    std::puts("Codec tipo 24: todos os testes passaram.");
+}
