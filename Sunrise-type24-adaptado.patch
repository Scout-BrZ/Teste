+/** Reserva revisões positivas sem permitir retorno a zero por estouro. */
+bool next_type24_revision(const Type24RevisionGuard& guard, std::int32_t& next) noexcept {
+    next = 0;
+    if (guard.hasLast && guard.last < 0) {
+        return false;
+    }
+    if (guard.hasLast && guard.last >= (std::numeric_limits<std::int32_t>::max)()) {
+        return false;
+    }
+    next = guard.hasLast ? static_cast<std::int32_t>(guard.last + 1) : 1;
+    return next > 0;
+}
+
+/** Codifica somente os canais declarados, após validar todos os valores. */
+bool encode_type24(const Type24Body& body, std::span<std::byte> output,
+                   std::size_t& written, std::size_t& writtenBits) noexcept {
+    written = 0;
+    writtenBits = 0;
+    if (body.count > kType24ChannelCapacity) {
+        return false;
+    }
+    const std::size_t bits = kType24CountWidth + body.count * kType24ChannelBitCount;
+    const std::size_t bytes = (bits + 7U) / 8U;
+    if (output.size() < bytes) {
+        return false;
+    }
+    for (const auto& channel : std::span(body.channels).first(body.count)) {
+        if (channel.revision < 0 || !std::isfinite(channel.value)
+            || channel.value < kType24MinimumValue || channel.value > kType24MaximumValue
+            || !std::isfinite(channel.blend) || channel.blend < 0.F) {
+            return false;
+        }
+    }
+    encoding::bits::Writer writer(output.first(bytes));
+    bool encoded = writer.write(body.count, kType24CountWidth);
+    for (const auto& channel : std::span(body.channels).first(body.count)) {
+        encoded = encoded
+                  && writer.write(std::bit_cast<std::uint32_t>(channel.revision) + kSigned32Bias,
+                                  kSigned32Width)
+                  && writer.write(std::bit_cast<std::uint32_t>(channel.value), kReal32Width)
+                  && writer.write(std::bit_cast<std::uint32_t>(channel.blend), kReal32Width);
+    }
+    if (!encoded || !writer.finish(written)) {
+        written = 0;
+        return false;
+    }
+    writtenBits = bits;
+    return true;
+}
+
+/** Rejeita mensagens truncadas, canais inválidos e bits de preenchimento não nulos. */
+bool decode_type24_body(std::span<const std::byte> input, Type24Body& body) noexcept {
+    body = {};
+    if (input.empty() || input.size() > kType24MaximumByteCount) {
+        return false;
+    }
+    encoding::bits::Reader reader(input);
+    std::uint64_t count = 0;
+    if (!reader.read(kType24CountWidth, count) || count > kType24ChannelCapacity) {
+        return false;
+    }
+    const std::size_t bits = kType24CountWidth + static_cast<std::size_t>(count) * kType24ChannelBitCount;
+    if (input.size() != (bits + 7U) / 8U) {
+        return false;
+    }
+    Type24Body parsed{};
+    parsed.count = static_cast<std::uint8_t>(count);
+    for (std::size_t index = 0; index < parsed.count; ++index) {
+        std::uint64_t revisionBits = 0;
+        std::uint64_t valueBits = 0;
+        std::uint64_t blendBits = 0;
+        if (!reader.read(kSigned32Width, revisionBits)
+            || !reader.read(kReal32Width, valueBits)
+            || !reader.read(kReal32Width, blendBits)) {
+            return false;
+        }
+        const std::uint32_t rawRevision = static_cast<std::uint32_t>(revisionBits) - kSigned32Bias;
+        const std::int32_t revision = std::bit_cast<std::int32_t>(rawRevision);
+        const float value = std::bit_cast<float>(static_cast<std::uint32_t>(valueBits));
+        const float blend = std::bit_cast<float>(static_cast<std::uint32_t>(blendBits));
+        if (revision < 0 || !std::isfinite(value) || value < kType24MinimumValue
+            || value > kType24MaximumValue || !std::isfinite(blend) || blend < 0.F) {
+            return false;
+        }
+        parsed.channels[index] = {revision, value, blend};
+    }
+    if (!finish_padding(reader)) {
+        return false;
+    }
+    body = parsed;
+    return true;
+}
+
+/** Verifica o tamanho exato em bits, além da estrutura da mensagem. */
+bool validate_type24_body(std::span<const std::byte> input, std::size_t bitCount) noexcept {
+    if (bitCount < kType24CountWidth || bitCount > kType24MaximumBitCount) {
+        return false;
+    }
+    Type24Body body{};
+    if (!decode_type24_body(input, body)) {
+        return false;
+    }
+    return bitCount == kType24CountWidth
+                                + static_cast<std::size_t>(body.count) * kType24ChannelBitCount;
+}
+
+
 } // namespace sunrise::middleware::bap::activity_message::scriptable_auth
